# Frontend environment configuration

# Vite dev server proxy target (vite.config.js)
VITE_PROXY_TARGET=http://127.0.0.1:5000

# API base path or endpoint (src/services/api.js)
# Use /api when running with Vite proxy or Docker Nginx
# Use full URL (e.g. https://api.yourdomain.com/api) if frontend is deployed separately without proxy
VITE_API_BASE_URL=/api
